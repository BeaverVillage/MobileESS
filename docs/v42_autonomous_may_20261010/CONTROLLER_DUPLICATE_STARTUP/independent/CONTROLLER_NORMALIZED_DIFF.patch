+@contextmanager
+def startup_supervisor_lock(root):
+    lock=exclusive_lock(root/'AUTONOMOUS_SUPERVISOR.lock')
+    try:lock.__enter__()
+    except LockBusy as error:
+        if not reject_verified_duplicate_startup(root,error):raise
+        yield False
+        return
+    try:yield True
+    finally:lock.__exit__(*sys.exc_info())
+
+
