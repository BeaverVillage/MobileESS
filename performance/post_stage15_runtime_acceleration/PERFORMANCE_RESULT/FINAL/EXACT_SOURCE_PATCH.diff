+def dependency_preflight() -> dict[str, Any]:
+    result = {"python_executable": sys.executable, "expected_python": PYTHON_AUTHORITY}
+    for name in ("numpy", "pandas", "gurobipy", "opendssdirect", "pyarrow"):
+        try:
