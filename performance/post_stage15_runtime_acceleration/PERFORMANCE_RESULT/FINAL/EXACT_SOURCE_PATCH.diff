diff --git a/performance/post_stage15_runtime_acceleration/package/authority/D/05_F7/generate_F7_coverage_certificate_split_authority_v2.py b/performance/post_stage15_runtime_acceleration/package/authority/D/05_F7/generate_F7_coverage_certificate_split_authority_v2.py
