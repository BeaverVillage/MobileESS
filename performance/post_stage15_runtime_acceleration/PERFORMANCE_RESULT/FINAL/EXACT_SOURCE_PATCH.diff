+class ProductionScienceBridge(Protocol):
+    def build_conditioned_model(
+        self,
+        *,
+        frame: CausalFrame,
+        pre_state: Any,
+        route_plan: RoutePlan,
+        route_steps: Mapping[str, Any],
+        work_assignments: Sequence[Any],
+        binding: PlanBindingEnvelope,
