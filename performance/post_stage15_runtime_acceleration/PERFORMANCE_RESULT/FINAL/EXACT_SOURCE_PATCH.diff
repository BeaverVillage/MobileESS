+  bi=(issue-START)//576
+  if bi==self._block:return
+  bd=self.root/"power_price"/f"block_{bi:02d}_{START+bi*576}_{START+(bi+1)*576-1}"
+  auth=load_json(bd/"BLOCK_AUTHORITY.json")
