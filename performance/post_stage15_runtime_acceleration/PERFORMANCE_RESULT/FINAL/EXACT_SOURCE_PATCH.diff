+def restore_modes(model: Any, saved: Mapping[Any, tuple[float, float, str]]) -> None:
+    for var, (lb, ub, vtype) in saved.items():
+        var.LB = lb
+        var.UB = ub
+        var.VType = vtype
+    model.update()
